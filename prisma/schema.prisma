generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(uuid())
  firebaseUid            String               @unique
  email                  String               @unique
  createdAt              DateTime             @default(now())
  stripeCustomerId       String?              @unique
  stripeSubscriptionId   String?              @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  subscriptionTier       String               @default("free")
  subscriptionStatus     String               @default("inactive")
  bio                    String?
  displayName            String?
  lastLoginAt            DateTime?
  location               String?
  phoneNumber            String?
  photoURL               String?
  updatedAt              DateTime             @default(now()) @updatedAt
  website                String?
  defaultAiModel         String?              @default("gpt-4o")
  sessionid              String?
  sessionidSign          String?
  analyses               Analysis[]
  automationSchedules    AutomationSchedule[]
  journalSettings        JournalSettings?
  layouts                Layout[]
  loginHistory           LoginHistory[]
  monthlyStats           MonthlyStats[]
  notifications          Notification[]
  telegramConfig         TelegramConfig?
  trades                 Trade[]
  settings               UserSettings?
}

model Layout {
  id                 String              @id @default(uuid())
  userId             String
  layoutId           String?
  symbol             String?
  interval           String?
  createdAt          DateTime            @default(now())
  automationSchedule AutomationSchedule?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots          Snapshot[]
}

model Snapshot {
  id        String    @id @default(uuid())
  layoutId  String
  url       String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  imageData String?
  analysis  Analysis?
  layout    Layout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Analysis {
  id               String            @id @default(uuid())
  userId           String
  snapshotId       String            @unique
  action           String
  confidence       Int
  timeframe        String
  reasons          Json
  createdAt        DateTime          @default(now())
  tradeSetup       Json?
  isMultiLayout    Boolean           @default(false)
  multiLayoutData  Json?
  aiErrors         Json?
  aiModel          String?
  aiModelName      String?
  deepseekAnalysis Json?
  openaiAnalysis   Json?
  isAutomated      Boolean           @default(false)
  snapshot         Snapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  history          AnalysisHistory[]
  economicContext  EconomicContext?
  trades           Trade[]
}

model EconomicEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  date      DateTime
  time      String?
  country   String
  currency  String?
  event     String
  impact    String
  category  String
  actual    String?
  forecast  String?
  previous  String?
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, impact])
  @@index([country, date])
  @@index([currency, date])
}

model EconomicContext {
  id               String   @id @default(uuid())
  analysisId       String   @unique
  symbol           String
  upcomingEvents   Json
  immediateRisk    String
  weeklyEvents     Json
  weeklyOutlook    String
  impactSummary    String
  warnings         Json
  opportunities    Json
  recommendation   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deepseekEconomic Json?
  openaiEconomic   Json?
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model AutomationSchedule {
  id                 String    @id @default(uuid())
  userId             String
  layoutId           String    @unique
  enabled            Boolean   @default(true)
  frequency          String
  customCron         String?
  sendToTelegram     Boolean   @default(true)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  onlyOnSignalChange Boolean   @default(false)
  minConfidence      Int       @default(0)
  sendOnHold         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  useMultiLayout     Boolean   @default(false)
  layout             Layout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextRunAt, enabled])
  @@index([userId])
}

model TelegramConfig {
  id              String    @id @default(uuid())
  userId          String    @unique
  chatId          String
  username        String?
  isActive        Boolean   @default(true)
  includeChart    Boolean   @default(true)
  includeEconomic Boolean   @default(true)
  notifyOnHold    Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalysisHistory {
  id               String    @id @default(uuid())
  analysisId       String
  previousAction   String
  newAction        String
  signalChanged    Boolean
  notificationSent Boolean   @default(false)
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  analysis         Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, createdAt])
}

model AutomationJobLog {
  id               String    @id @default(uuid())
  scheduleId       String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  duration         Int?
  status           String
  action           String?
  confidence       Int?
  previousAction   String?
  signalChanged    Boolean   @default(false)
  metMinConfidence Boolean   @default(true)
  telegramSent     Boolean   @default(false)
  telegramChatId   String?
  telegramError    String?
  skipReason       String?
  errorMessage     String?
  errorStack       String?
  screenshotPath   String?
  analysisId       String?
  createdAt        DateTime  @default(now())

  @@index([scheduleId, createdAt])
  @@index([status, createdAt])
}

model JournalSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  startingBalance     Decimal  @db.Decimal(15, 2)
  currentBalance      Decimal  @db.Decimal(15, 2)
  currency            String   @default("GBP")
  timezone            String   @default("UTC")
  defaultPositionSize Decimal? @db.Decimal(10, 4)
  defaultRiskPercent  Decimal? @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id                   String    @id @default(uuid())
  userId               String
  date                 DateTime
  time                 String
  direction            String
  market               String
  entryPrice           Decimal   @db.Decimal(15, 8)
  accountBalance       Decimal   @db.Decimal(15, 2)
  positionSize         Decimal   @db.Decimal(15, 8)
  stopLossPrice        Decimal?  @db.Decimal(15, 8)
  takeProfitPrice      Decimal?  @db.Decimal(15, 8)
  actualExitPrice      Decimal?  @db.Decimal(15, 8)
  exitDate             DateTime?
  exitTime             String?
  tradeCosts           Decimal   @default(0) @db.Decimal(10, 2)
  riskRewardRatio      String?
  closedPositionPL     Decimal?  @db.Decimal(15, 2)
  accountChangePercent Decimal?  @db.Decimal(8, 4)
  tradeScreenshot      String?
  tradeNotes           String?
  disciplineRating     Int?
  emotionalState       String?
  strategy             String?
  setup                String?
  tags                 Json?
  status               String    @default("open")
  analysisId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  accountNumber        String?
  analysis             Analysis? @relation(fields: [analysisId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, status])
  @@index([market, date])
}

model MonthlyStats {
  id                     String   @id @default(uuid())
  userId                 String
  year                   Int
  month                  Int
  totalTrades            Int      @default(0)
  winningTrades          Int      @default(0)
  losingTrades           Int      @default(0)
  breakEvenTrades        Int      @default(0)
  winRate                Decimal  @default(0) @db.Decimal(5, 2)
  totalPL                Decimal  @default(0) @db.Decimal(15, 2)
  averageWin             Decimal? @db.Decimal(15, 2)
  averageLoss            Decimal? @db.Decimal(15, 2)
  largestWin             Decimal? @db.Decimal(15, 2)
  largestLoss            Decimal? @db.Decimal(15, 2)
  averagePLPerTrade      Decimal? @db.Decimal(15, 2)
  totalTradeCosts        Decimal  @default(0) @db.Decimal(15, 2)
  averageRiskPerTrade    Decimal? @db.Decimal(8, 4)
  averageRewardPerTrade  Decimal? @db.Decimal(8, 4)
  averageRiskRewardRatio String?
  returnOnInvestment     Decimal? @db.Decimal(8, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model UserSettings {
  id                    String    @id @default(uuid())
  userId                String    @unique
  emailNotifications    Boolean   @default(true)
  pushNotifications     Boolean   @default(true)
  marketingEmails       Boolean   @default(false)
  securityAlerts        Boolean   @default(true)
  notificationFrequency String    @default("instant")
  twoFactorEnabled      Boolean   @default(false)
  lastPasswordChange    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  preferredAiModel      String?   @default("openai")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean   @default(false)
  actionUrl String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  location  String?
  device    String?
  browser   String?
  loginAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
}
